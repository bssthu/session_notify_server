[Unit]
Description=Renew and verify Session Notify public HTTPS certificate (user)

[Service]
Type=oneshot
# Generated by render_systemd.py; install the generated copy, not this template.
# manage.sh resolves and enters its own repository directory.
ExecStart=/usr/bin/env bash __MANAGE_SCRIPT__ renew
TimeoutStartSec=30min
UMask=0077
