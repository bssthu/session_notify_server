# Copy to runtime/public-https/config.env; shell syntax, writable by the operator only.
# Signing and renewal run inside the HTTPS gateway as fixed UID:GID 0:0.
# Set the actual public IPv4 address in the ignored runtime config, not here.
HTTPS_PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4
# Public HTTPS port; the container's internal TLS listener remains 443.
HTTPS_PUBLIC_PORT=443
# Backend listener/publication ports are read from the rendered Compose config.
# Configure SESSION_NOTIFY_PORT / SESSION_NOTIFY_HOST_PORT in the root .env.
# Set a contact email, or leave it empty and explicitly set the flag to true.
HTTPS_ACME_EMAIL=
HTTPS_ACME_REGISTER_WITHOUT_EMAIL=false
# Must exactly match the already running server's Compose project label.
HTTPS_COMPOSE_PROJECT=REPLACE_WITH_EXISTING_PROJECT
# Exact DNS SAN of ORIGINAL runtime/secrets/server.crt, not the Docker service name.
# The repository certificate generator defaults to DNS:localhost.
HTTPS_UPSTREAM_TLS_NAME=localhost
# Debian/Ubuntu default; adjust to your distro's maintained PUBLIC root bundle.
HTTPS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
