# Optional: copy to runtime/deploy/update.env. Trusted operator-owned shell syntax.
# Leave empty to use normal Compose project selection; set the EXISTING project
# name if it was originally deployed with -p / COMPOSE_PROJECT_NAME.
UPDATE_COMPOSE_PROJECT=
# Backend health endpoint, not the optional public HTTPS entry point.
UPDATE_HEALTH_URL=https://127.0.0.1:8765/health
UPDATE_HEALTH_CA_FILE=runtime/secrets/server.crt
UPDATE_HEALTH_RETRIES=30
UPDATE_HEALTH_INTERVAL_SECONDS=2
