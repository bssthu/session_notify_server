SESSION_NOTIFY_DB=runtime/session_notify.db
SESSION_NOTIFY_HOST=127.0.0.1
# Compose container listener. Defaults to 8765 when unset.
SESSION_NOTIFY_PORT=8765
# Compose host publication. When unset, follows SESSION_NOTIFY_PORT.
SESSION_NOTIFY_HOST_PORT=8765
SESSION_NOTIFY_ACCESS_TTL_SECONDS=7200
# Per-device publication limits (positive integers; also passed through Compose).
SESSION_NOTIFY_PUBLISH_PER_MINUTE=600
SESSION_NOTIFY_PUBLISH_BYTES_PER_DAY=67108864
# Internal gateway metadata for administrator certificate warnings. No host port.
SESSION_NOTIFY_GATEWAY_STATUS_URL=http://public-https:9080/status
